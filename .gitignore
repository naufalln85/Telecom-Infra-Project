# File dan folder yang TIDAK boleh masuk ke Git repository
# ============================================================

# Variabel lingkungan — berisi password dan secret key!
# JANGAN PERNAH commit file ini ke Git
.env
.env.local
.env.production
.env.staging

# Virtual environment Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging Python
dist/
build/
*.egg-info/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

