# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — IoT Platform TIP (Modul A)
#
# INSTRUKSI:
#   1. Salin file ini: cp .env.example .env
#   2. Isi semua nilai yang bertanda ← WAJIB DIISI
#   3. File .env TIDAK BOLEH di-commit ke Git (sudah ada di .gitignore)
#
# KEAMANAN:
#   - Gunakan password yang kuat (min 20 karakter, random)
#   - SECRET_KEY bisa dibuat dengan: python -c "import secrets; print(secrets.token_hex(32))"
#   - Di production VPS: gunakan environment variable dari sistem (bukan .env file)
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=tip_admin                      # ← WAJIB: Username database
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT_DISINI # ← WAJIB: Password database
POSTGRES_DB=iot_platform_tip                 # ← WAJIB: Nama database
POSTGRES_HOST=db                             # Nama service di docker-compose
POSTGRES_PORT=5432                           # Port PostgreSQL (default 5432)

# URL koneksi lengkap (dipakai oleh SQLAlchemy + Alembic)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://tip_admin:GANTI_PASSWORD_KUAT_DISINI@db:5432/iot_platform_tip

# URL koneksi untuk Alembic (sync, bukan async — Alembic belum support asyncpg langsung)
DATABASE_URL_SYNC=postgresql+psycopg2://tip_admin:GANTI_PASSWORD_KUAT_DISINI@db:5432/iot_platform_tip

# Jika FastAPI dijalankan langsung di VM/host, bukan di container Docker:
# DATABASE_URL=postgresql+asyncpg://tip_admin:GANTI_PASSWORD_KUAT_DISINI@127.0.0.1:5432/iot_platform_tip
# DATABASE_URL_SYNC=postgresql+psycopg2://tip_admin:GANTI_PASSWORD_KUAT_DISINI@127.0.0.1:5432/iot_platform_tip

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=GANTI_REDIS_PASSWORD_DISINI   # ← WAJIB: Password Redis
REDIS_HOST=redis                             # Nama service di docker-compose
REDIS_PORT=6379                              # Port Redis (default 6379)
REDIS_MAXMEMORY=512mb                        # Batas memori Redis

# URL koneksi Redis (dipakai redis-py)
REDIS_URL=redis://:GANTI_REDIS_PASSWORD_DISINI@redis:6379/0

# Jika FastAPI dijalankan langsung di VM/host, bukan di container Docker:
# REDIS_URL=redis://:GANTI_REDIS_PASSWORD_DISINI@127.0.0.1:6379/0

# Database Redis terpisah per kebutuhan (0-15 tersedia):
REDIS_DB_CACHE=0       # Untuk cache auth device
REDIS_DB_STREAMS=1     # Untuk Redis Streams (event bus)
REDIS_DB_COOLDOWN=2    # Untuk cooldown alert

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_DENGAN_RANDOM_HEX_64_KARAKTER # ← WAJIB

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60         # Token expire 1 jam
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7            # Refresh token expire 7 hari

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development                          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1                               # Jumlah Uvicorn workers (production: jumlah CPU core * 2 + 1)
DEBUG=true                                  # Set ke false di production!
LOG_LEVEL=info                              # debug | info | warning | error
SQLALCHEMY_ECHO=false                       # true hanya untuk debug lokal; false agar SQL dan parameter sensitif tidak bocor ke log

# Nama aplikasi (muncul di Swagger /docs)
APP_TITLE=IoT Platform TIP - Modul A API
APP_VERSION=0.1.0
APP_DESCRIPTION=Authentication, Hierarchy, Alert Engine & Notification Dispatcher

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# CORS — daftar origin yang boleh akses API ini
# Di development: http://localhost:3000 (frontend dev server)
# Di production: ganti ke domain frontend yang sebenarnya
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (opsional, bisa diaktifkan nanti)
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Notification Dispatcher (Modul A - Alert Engine)
# -----------------------------------------------------------------------------
# Interval polling consumer Redis Streams (dalam milidetik)
ALERT_ENGINE_POLL_INTERVAL_MS=100

# Maksimal pesan yang dibaca per batch XREADGROUP
ALERT_ENGINE_BATCH_SIZE=10

# Nama consumer group Alert Engine di Redis Streams
ALERT_ENGINE_CONSUMER_GROUP=alert-engine-group

# Nama stream yang dipakai (harus sama dengan yang ditulis Modul B!)
# KOORDINASI DENGAN MODUL B: pastikan nama ini disepakati
REDIS_STREAM_TELEMETRY=tip:telemetry:events

# -----------------------------------------------------------------------------
# IoT Protocol Gateway (Modul B)
# -----------------------------------------------------------------------------
# Port untuk masing-masing protokol ingestion
GATEWAY_HTTP_PORT=3000                       # HTTP REST Ingestion (Express)
GATEWAY_MQTT_PORT=1884                       # MQTT Broker (Aedes)
GATEWAY_COAP_PORT=5683                       # CoAP UDP Server

# URL backend tujuan dari gateway (di Docker: gunakan nama service)
BACKEND_URL=http://backend:8000/api/v1/save-data

# Jika gateway dijalankan di luar Docker (lokal dev):
# BACKEND_URL=http://localhost:8000/api/v1/save-data
